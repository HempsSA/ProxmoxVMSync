<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Light theme ─────────────────────────────────────────── -->
    <Color x:Key="WindowColor">#FAFAFA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F1F3F5</Color>
    <Color x:Key="BorderColor">#D8DEE4</Color>
    <Color x:Key="ForegroundColor">#1F2937</Color>
    <Color x:Key="MutedForegroundColor">#6B7280</Color>
    <Color x:Key="StatusBgColor">#F3F4F6</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource MutedForegroundColor}"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="{StaticResource StatusBgColor}"/>
    <SolidColorBrush x:Key="AlternatingRowBrush" Color="#F8F9FA"/>

    <!-- Status / health colors -->
    <SolidColorBrush x:Key="HealthGood" Color="#16A34A"/>
    <SolidColorBrush x:Key="HealthWarning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="HealthBad" Color="#DC2626"/>
    <SolidColorBrush x:Key="HealthInfo" Color="#94A3B8"/>

    <!-- Accents (shared) -->
    <SolidColorBrush x:Key="AccentBlue" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#16A34A"/>
    <SolidColorBrush x:Key="AccentRed" Color="#DC2626"/>
    <SolidColorBrush x:Key="AccentYellow" Color="#F59E0B"/>
    <SolidColorBrush x:Key="NeutralBtn" Color="#E5E7EB"/>

    <!-- TextBox / PasswordBox / ComboBox base template colors -->
    <Color x:Key="InputBgColor">#FFFFFF</Color>
    <Color x:Key="InputBorderColor">#CBD5E1</Color>
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>

    <!-- DataGrid color handling -->
    <SolidColorBrush x:Key="GridColumnHeaderBg" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="GridRowSelectorHover" Color="#E5E7EB"/>

    <!-- Element-level styles: WPF defaults these to system white/black,
         so set them explicitly to stay readable on the light theme. -->
    <Style x:Key="DarkCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="2,2,2,2"/>
    </Style>
    <Style x:Key="DarkComboItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Padding" Value="6,3,6,3"/>
    </Style>
    <Style x:Key="DarkListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
    </Style>

    <!-- Custom ControlTemplates: same structure for both themes;
         DynamicResource picks up whichever palette is loaded. -->
    <ControlTemplate TargetType="{x:Type TabItem}" x:Key="ThemedTabItemTemplate">
        <Border x:Name="TabBorder"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,1,1,0"
                Padding="{TemplateBinding Padding}"
                CornerRadius="4,4,0,0"
                Margin="2,2,0,0">
            <ContentPresenter ContentSource="Header"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource WindowBrush}"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate TargetType="{x:Type TabControl}" x:Key="ThemedTabControlTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,1,1,0"
                    Padding="0,4,0,0">
                <TabPanel x:Name="HeaderPanel" IsItemsHost="True"
                          KeyboardNavigation.DirectionalNavigation="Contained"/>
            </Border>
            <Border Grid.Row="1"
                    Background="{DynamicResource WindowBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,1,1"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter ContentSource="SelectedContent"
                                  x:Name="PART_SelectedContentHost"/>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- ComboBox template (same structure, DynamicResource picks up active palette) -->
    <ControlTemplate TargetType="{x:Type ComboBox}" x:Key="ThemedComboBoxTemplate">
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ContentBorder" Grid.Column="0"
                    Background="{DynamicResource InputBgBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="ContentSite"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,0,0"/>
            </Border>

            <ToggleButton x:Name="PART_ToggleButton" Grid.Column="1"
                          Background="{DynamicResource SurfaceAltBrush}"
                          BorderBrush="{DynamicResource InputBorderBrush}"
                          BorderThickness="0,1,1,1" Width="20"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          Focusable="False">
                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="{DynamicResource ForegroundBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ToggleButton>

            <Popup x:Name="PART_Popup" Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True" Focusable="False">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" Margin="0,2,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,2,0,2">
                        <StackPanel IsItemsHost="True"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate TargetType="{x:Type CheckBox}" x:Key="ThemedCheckBoxTemplate">
        <BulletDecorator Background="Transparent">
            <BulletDecorator.Bullet>
                <Border x:Name="Border" Width="16" Height="16"
                        Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1" CornerRadius="2">
                    <Path x:Name="CheckMark"
                          Data="M 2 6 L 6 10 L 12 2"
                          Stroke="Black" StrokeThickness="2"
                          Visibility="Collapsed"/>
                </Border>
            </BulletDecorator.Bullet>
            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                              HorizontalAlignment="Left" RecognizesAccessKey="True"/>
        </BulletDecorator>

        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBlue}"/>
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
