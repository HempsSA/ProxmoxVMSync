<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\DarkSync_Proxmox_Archive.ico</ApplicationIcon>
    <AssemblyName>DarkSync</AssemblyName>
    <RootNamespace>DarkSync</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyTitle>DarkSync Proxmox Archive</AssemblyTitle>
    <Description>Desktop GUI tool for managing Proxmox VE backup archives</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="DarkSync_Proxmox_Archive.ico" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

</Project>
